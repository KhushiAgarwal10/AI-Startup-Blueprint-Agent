# ==============================================================================
# IBM watsonx.ai Credentials
# ==============================================================================
# Your IBM Cloud API Key – create one at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai project ID – found in your watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai service URL – select the region closest to you
# US South  : https://us-south.ml.cloud.ibm.com
# EU DE     : https://eu-de.ml.cloud.ibm.com
# EU GB     : https://eu-gb.ml.cloud.ibm.com
# JP Tokyo  : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ==============================================================================
# Flask Application Settings
# ==============================================================================
# A long, random secret string used to sign session cookies
FLASK_SECRET_KEY=change_me_to_a_long_random_string_in_production

# Set to "production" on IBM Cloud Code Engine, "development" locally
FLASK_ENV=development

# Port the server listens on (Code Engine expects 8080)
PORT=8080

# ==============================================================================
# IBM Granite Model Selection (optional – defaults shown)
# ==============================================================================
# Primary generation model
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# ==============================================================================
# Agent Behaviour Tuning (optional – defaults shown)
# ==============================================================================
# 0.0 = deterministic/conservative  |  1.0 = very creative
AGENT_TEMPERATURE=0.7

# Max tokens to generate per response (higher = more detailed blueprints)
AGENT_MAX_TOKENS=4096

# Top-P nucleus sampling (0.9 is a safe default)
AGENT_TOP_P=0.9
